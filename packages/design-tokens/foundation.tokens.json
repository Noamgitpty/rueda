{
  "$description": "US-030 — socle commun à toutes les palettes : valeurs par défaut des jetons ajoutés après US-028 (langage visuel de PROPOSITIONS, « Passage à US-030 »). Une palette peut redéfinir chacun ; ces défauts sont des alias vers ses propres jetons, pour qu'une palette plus ancienne reste complète sans valeur inventée.",
  "color": {
    "light": {
      "avatar-1": {
        "$value": "{color.light.accent}",
        "$type": "color"
      },
      "on-avatar-1": {
        "$value": "{color.light.on-accent}",
        "$type": "color"
      },
      "avatar-2": {
        "$value": "{color.light.warning-soft}",
        "$type": "color"
      },
      "on-avatar-2": {
        "$value": "{color.light.warning}",
        "$type": "color"
      },
      "avatar-3": {
        "$value": "{color.light.success-soft}",
        "$type": "color"
      },
      "on-avatar-3": {
        "$value": "{color.light.success}",
        "$type": "color"
      },
      "avatar-4": {
        "$value": "{color.light.surface-sunken}",
        "$type": "color"
      },
      "on-avatar-4": {
        "$value": "{color.light.text}",
        "$type": "color"
      }
    },
    "dark": {
      "avatar-1": {
        "$value": "{color.dark.accent}",
        "$type": "color"
      },
      "on-avatar-1": {
        "$value": "{color.dark.on-accent}",
        "$type": "color"
      },
      "avatar-2": {
        "$value": "{color.dark.warning-soft}",
        "$type": "color"
      },
      "on-avatar-2": {
        "$value": "{color.dark.warning}",
        "$type": "color"
      },
      "avatar-3": {
        "$value": "{color.dark.success-soft}",
        "$type": "color"
      },
      "on-avatar-3": {
        "$value": "{color.dark.success}",
        "$type": "color"
      },
      "avatar-4": {
        "$value": "{color.dark.surface-sunken}",
        "$type": "color"
      },
      "on-avatar-4": {
        "$value": "{color.dark.text}",
        "$type": "color"
      }
    }
  },
  "font": {
    "display": {
      "family": {
        "$value": "{font.family.heading}",
        "$type": "fontFamily"
      },
      "weight": {
        "$value": "{font.weight.heading}",
        "$type": "fontWeight"
      },
      "size": {
        "$value": "40px",
        "$type": "dimension"
      },
      "sizeCompact": {
        "$value": "36px",
        "$type": "dimension",
        "$description": "Titre d'affichage sous 400 px de large"
      },
      "letterSpacing": {
        "$value": "-0.02em",
        "$type": "dimension"
      },
      "lineHeight": {
        "$value": 1.05,
        "$type": "number"
      }
    }
  },
  "size": {
    "focusRing": {
      "$value": "2px",
      "$type": "dimension",
      "$description": "Épaisseur de l'anneau de focus (10b, PROPOSITIONS « États soignés »)"
    },
    "focusOffset": {
      "$value": "2px",
      "$type": "dimension"
    }
  },
  "radius": {
    "card": {
      "$value": "{radius.lg}",
      "$type": "dimension"
    }
  },
  "shadow": {
    "card": {
      "$value": "{shadow.raised}",
      "$type": "shadow",
      "$extensions": {
        "org.rueda": {
          "dark": "0 0 0 1px rgba(255,255,255,.08), 0 1px 2px rgba(0,0,0,.6), 0 12px 32px -12px rgba(0,0,0,.8)"
        }
      },
      "$description": "En sombre, une ombre noire ne se voit pas sur #111214 : un liseré clair de 1 px dessine le bord, l'ombre portée reste en dessous (revue UX US-030)."
    },
    "float": {
      "$value": "{shadow.raised}",
      "$type": "shadow",
      "$extensions": {
        "org.rueda": {
          "dark": "0 0 0 1px rgba(255,255,255,.12), 0 2px 4px rgba(0,0,0,.6), 0 20px 40px -12px rgba(0,0,0,.85)"
        }
      }
    }
  },
  "motion": {
    "duration": {
      "enter": {
        "$value": "280ms",
        "$type": "duration",
        "$description": "Apparition d'un écran ou d'un bloc au défilement"
      },
      "page": {
        "$value": "300ms",
        "$type": "duration",
        "$description": "Transition carte → fiche"
      },
      "signature": {
        "$value": "700ms",
        "$type": "duration",
        "$description": "Exceptions assumées, une fois : tracé du camino, compteur de revenus (UX-69)"
      },
      "skeleton": {
        "$value": "1400ms",
        "$type": "duration",
        "$description": "Un balayage du squelette de chargement"
      },
      "stagger": {
        "$value": "40ms",
        "$type": "duration",
        "$description": "US-031 : décalage entre deux éléments d'une liste qui apparaît (au plus 6 éléments décalés)"
      }
    },
    "iterations": {
      "skeleton": {
        "$value": 3,
        "$type": "number",
        "$description": "Le squelette balaie trois fois puis s'arrête"
      }
    },
    "easing": {
      "exit": {
        "$value": [0.4, 0, 1, 1],
        "$type": "cubicBezier",
        "$description": "US-031 : sortie (fermeture d'une feuille, disparition d'un toast) ; accélère, sans rebond"
      }
    },
    "scale": {
      "press": {
        "$value": 0.98,
        "$type": "number",
        "$description": "US-031 : échelle d'un élément pressé (bouton, carte) ; vaut 1 avec prefers-reduced-motion"
      }
    }
  },
  "glass": {
    "opacity": {
      "$value": 0.86,
      "$type": "number",
      "$description": "Opacité de surface-raised sous le verre ; contraste vérifié au pire cas (UX-49)"
    },
    "blur": {
      "$value": "18px",
      "$type": "dimension"
    },
    "saturate": {
      "$value": 1.6,
      "$type": "number"
    }
  },
  "camino": {
    "strokeWidth": {
      "$value": "2.5px",
      "$type": "dimension"
    },
    "dashArray": {
      "$value": [0.006, 0.018],
      "$type": "number",
      "$description": "Pointillés ronds, en longueur de tracé normalisée (pathLength = 1)"
    }
  }
}
