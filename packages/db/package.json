{
  "name": "@rueda/db",
  "version": "0.0.0",
  "private": true,
  "description": "Base PostgreSQL : correspondance module → schéma, migrations SQL versionnées, exécuteur de migrations, harnais de tests (US-005), liste blanche de l'horloge, journal d'audit chaîné, clés par sujet et magasin de preuves (US-009).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./audit": "./src/audit/index.ts",
    "./schemas": "./schemas.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/global-setup": "./src/testing/global-setup.ts",
    "./testing/setup-l0-05": "./src/testing/setup-l0-05.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:l0": "vitest run --config vitest.l0.config.ts",
    "test:c11": "vitest run --config vitest.l0.config.ts test/l0/l0-c11-fuzz.test.ts"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@rueda/config": "workspace:*",
    "@rueda/fake-adapters": "workspace:*",
    "@rueda/money": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
