        "subject_type": "C1",
        "subject_id": "C1",
        "before": "C1",
        "after": "C1",
        "reason": {
          "class": "C2",
          "erasure": "derogation",
          "justification": "motif libre recopié en clair dans un registre en ajout seul : ni UPDATE (pseudonymisation) ni clé de sujet ; consigne : aucun nom, contact ni identifiant de personne dans un motif",
          "report": "US-536"
        },
        "ip_enc": {
          "class": "C2",
          "erasure": "crypto-shredding",
          "key": ["ip_key_subject_type", "ip_key_subject_id"]
        },
        "ip_key_subject_type": "C1",
        "ip_key_subject_id": "C1",
        "c2_withheld": "C1",
