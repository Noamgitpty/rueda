# Pile de développement local (compose.yaml, US-035). Copier en `.env` pour changer un port :
#   cp .env.example .env
# AUCUN secret ici : les mots de passe PostgreSQL sont tirés au hasard au premier lancement
# (service secrets-init, volumes Docker). Ne jamais ajouter de mot de passe, de clé ni de jeton.

# Port local (127.0.0.1) de PostgreSQL 16
RUEDA_DEV_PG_PORT=5432
# Port local (127.0.0.1) de l'API
RUEDA_DEV_API_PORT=3000
