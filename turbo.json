{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "outputs": []
    },
    "test:int": {
      "dependsOn": ["^test:int"],
      "cache": false,
      "passThroughEnv": ["RUEDA_PG_*", "DOCKER_*", "TESTCONTAINERS_*"],
      "outputs": []
    },
    "test:l0": {
      "cache": false,
      "passThroughEnv": [
        "RUEDA_PG_*",
        "RUEDA_C11_*",
        "RUEDA_QA_REPORT_DIR",
        "DOCKER_*",
        "TESTCONTAINERS_*"
      ],
      "outputs": []
    }
  }
}
