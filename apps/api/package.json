{
  "name": "@rueda/api",
  "version": "0.0.0",
  "private": true,
  "description": "Back-end NestJS (monolithe modulaire) : API (main.ts) et travailleur pg-boss (worker.ts), une image.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@rueda/config": "workspace:*",
    "@rueda/db": "workspace:*",
    "@rueda/i18n": "workspace:*",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
