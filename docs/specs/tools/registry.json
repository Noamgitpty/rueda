      ]
    },
    "verif12_t49plus.py": {
      "require": [
        "^38/38$"
      ],
      "counts": {
        "vecteurs": 38
      }
    },
    "check_t49plus.py": {
      "require": [
        "^T49-T65 : ecarts = 0$"
      ]
    },
    "check_verif12_fixes.py": {
      "require": [
        "^0 ecart$"
      ],
      "forbid": [
        "ECART\\(S\\)"
      ]
    },
    "check_t66_68.py": {
      "require": [
        "^RÉSULTAT : OK\\s*$"
      ]
    },
    "check_ta_consolidation.py": {
      "require": [
