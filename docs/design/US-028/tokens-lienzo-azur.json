{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "US-028 - direction « Lienzo · Azur » (famille blanc épuré, 2026-11-02). Format DTCG (brouillon). Proposée après le retour du fondateur du 2026-11-02 ; en attente de son choix.",
  "meta": {
    "direction": "lienzo-azur",
    "status": "PROPOSÉ : en attente du choix du fondateur ; nom Kmino tranché le 2026-11-02",
    "story": "US-028",
    "version": "0.1.0",
    "date": "2026-11-02",
    "wcag": "2.2 AA, ratios calculés (formule WCAG 2.x de luminance relative), voir contrastChecks",
    "concept": "Le même blanc pur, avec un bleu azur vif mais doux : l'air d'un matin clair. Plus accueillant que Tinta, plus calme que Voltio ; le bleu reste rare et signale ce qui se touche.",
    "paletteLogic": "Blanc + gris neutres + un bleu azur moyen (≈ 213°, saturation modérée) : un seul bleu pour l'action, ses nuances pâles pour les pastilles ; aucun fond teinté, aucun noir en aplat.",
    "notes": "Le nom et le logo sont des données de thème (US-034) : remplacer brand.name et brand.logo ne demande aucun développement. Le thème clair est la vitrine ; le thème sombre est obligatoire pour l'accessibilité."
  },
  "brand": {
    "name": {
      "$value": "Kmino",
      "$type": "string",
      "$description": "Valeur du paramètre {brand_name} (DEC-MARQUE, tranchée par le fondateur le 2026-11-02). Donnée de thème, révisable sans développement (US-034). Toujours en un seul mot, K majuscule, sans tiret ni point."
    },
    "parameter": {
      "$value": "{brand_name}",
      "$type": "string",
      "$description": "Le code n'écrit jamais le nom en dur : il lit ce paramètre."
    },
    "slug": {
      "$value": "kmino",
      "$type": "string",
      "$description": "Identifiant technique (domaines, comptes, paquets, clés) : minuscules, sans tiret."
    },
    "pronunciation": {
      "$value": "ka-MI-no",
      "$type": "string",
      "$description": "De camino et de km. En anglais : kah-MEE-no."
    },
    "wordmark": {
      "$value": "Kmino",
      "$type": "string",
      "$description": "Bricolage Grotesque 700. Le K prend color.primary et « mino » color.text : la coupure K / mino n'est marquée que par la couleur, jamais par un tiret ou un point dans le texte."
    },
    "logo": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><rect x=\"3\" y=\"3\" width=\"42\" height=\"42\" rx=\"12\" fill=\"#1E6AC2\"/><path d=\"M16 12v24M29 12L17.5 23.5M21.5 20L30 34\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"37\" cy=\"37\" r=\"2.6\" fill=\"#FFFFFF\"/></svg>",
      "$type": "string",
      "$description": "Un carré aux angles doux porte un K au trait fin ; un point dans l'angle marque le repère (le point sur la carte). Ici le carré est azur, K et point blancs. « Kmino » en Bricolage Grotesque 700, le K en azur. Thème clair : K en on-primary (5.39:1 sur primary), repère #FFFFFF (5.39:1)."
    },
    "logoDark": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><rect x=\"3\" y=\"3\" width=\"42\" height=\"42\" rx=\"12\" fill=\"#7DB4F5\"/><path d=\"M16 12v24M29 12L17.5 23.5M21.5 20L30 34\" fill=\"none\" stroke=\"#0B0C0D\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"37\" cy=\"37\" r=\"2.6\" fill=\"#0B0C0D\"/></svg>",
      "$type": "string",
      "$description": "Thème sombre : pictogramme en primary sombre, K en on-primary (9.06:1), repère #0B0C0D (9.06:1)."
    },
    "logoMono": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><rect x=\"3\" y=\"3\" width=\"42\" height=\"42\" rx=\"12\" fill=\"currentColor\"/><path d=\"M16 12v24M29 12L17.5 23.5M21.5 20L30 34\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"37\" cy=\"37\" r=\"2.6\" fill=\"#FFFFFF\"/></svg>",
      "$type": "string",
      "$description": "Variante monochrome : forme en currentColor, traits en blanc écrits en dur (fonctionne aussi en <img>) ; à n'utiliser que si currentColor contraste à 3:1 au moins avec le blanc."
    }
  },
