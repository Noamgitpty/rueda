  "contrastChecks": {
    "light": [
      {
        "pair": "texte / surface",
        "fg": "#17181B",
        "bg": "#FFFFFF",
        "ratio": 17.75,
        "min": 4.5,
        "pass": true
      },
      {
        "pair": "texte / carte",
        "fg": "#17181B",
        "bg": "#FFFFFF",
        "ratio": 17.75,
        "min": 4.5,
        "pass": true
      },
