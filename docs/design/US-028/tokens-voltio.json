{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "US-028 - direction « Voltio » (palettes claires, 2026-11-02). Format DTCG (brouillon). Proposée après le retour du fondateur du 2026-11-02 ; en attente de son choix.",
  "meta": {
    "direction": "voltio",
    "status": "PROPOSÉ : en attente du choix du fondateur ; nom Kmino tranché le 2026-11-02",
    "story": "US-028",
    "version": "0.1.0",
    "date": "2026-11-02",
    "wcag": "2.2 AA, ratios calculés (formule WCAG 2.x de luminance relative), voir contrastChecks",
    "concept": "Le blanc pur d'un écran bien réglé, un bleu électrique pour chaque action et le noir pour la structure : contraste maximal, lecture immédiate au soleil, au moment de la remise des clés.",
    "paletteLogic": "Achromatique + une seule couleur saturée : blanc, gris et noir neutres (sans teinte) et un bleu électrique (≈ 220°) réservé à l'action ; le noir sert de contraste fort (onglet actif, numéros, focus).",
    "notes": "Le nom et le logo sont des données de thème (US-034) : remplacer brand.name et brand.logo ne demande aucun développement. Le thème clair est la vitrine ; le thème sombre est obligatoire pour l'accessibilité."
  },
  "brand": {
    "name": {
      "$value": "Kmino",
      "$type": "string",
      "$description": "Valeur du paramètre {brand_name} (DEC-MARQUE, tranchée par le fondateur le 2026-11-02). Donnée de thème, révisable sans développement (US-034). Toujours en un seul mot, K majuscule, sans tiret ni point."
    },
    "parameter": {
      "$value": "{brand_name}",
      "$type": "string",
      "$description": "Le code n'écrit jamais le nom en dur : il lit ce paramètre."
    },
    "slug": {
      "$value": "kmino",
      "$type": "string",
      "$description": "Identifiant technique (domaines, comptes, paquets, clés) : minuscules, sans tiret."
    },
    "pronunciation": {
      "$value": "ka-MI-no",
      "$type": "string",
      "$description": "De camino et de km. En anglais : kah-MEE-no."
    },
    "wordmark": {
      "$value": "Kmino",
      "$type": "string",
      "$description": "Archivo 800. Le K prend color.primary et « mino » color.text : la coupure K / mino n'est marquée que par la couleur, jamais par un tiret ou un point dans le texte."
    },
    "logo": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><rect x=\"2\" y=\"2\" width=\"44\" height=\"44\" rx=\"2\" fill=\"#0A5CFF\"/><path d=\"M14 9v29M32 9L16 24.5M21 20l11 18\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"5.5\" stroke-linecap=\"square\"/><rect x=\"36\" y=\"36\" width=\"6\" height=\"6\" fill=\"#0A0A0B\"/></svg>",
      "$type": "string",
      "$description": "Un carré bleu électrique porte un K blanc épais ; un petit carré noir dans l'angle marque la borne (km). « Kmino » en Archivo 800, le K en bleu. Thème clair : K en on-primary (5.27:1 sur primary), repère #0A0A0B (3.76:1)."
    },
    "logoDark": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><rect x=\"2\" y=\"2\" width=\"44\" height=\"44\" rx=\"2\" fill=\"#5C8DFF\"/><path d=\"M14 9v29M32 9L16 24.5M21 20l11 18\" fill=\"none\" stroke=\"#0A0A0B\" stroke-width=\"5.5\" stroke-linecap=\"square\"/><rect x=\"36\" y=\"36\" width=\"6\" height=\"6\" fill=\"#0A0A0B\"/></svg>",
      "$type": "string",
      "$description": "Thème sombre : pictogramme en primary sombre, K en on-primary (6.32:1), repère #0A0A0B (6.32:1)."
    },
    "logoMono": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><rect x=\"2\" y=\"2\" width=\"44\" height=\"44\" rx=\"2\" fill=\"currentColor\"/><path d=\"M14 9v29M32 9L16 24.5M21 20l11 18\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"5.5\" stroke-linecap=\"square\"/><rect x=\"36\" y=\"36\" width=\"6\" height=\"6\" fill=\"#FFFFFF\"/></svg>",
      "$type": "string",
      "$description": "Variante monochrome : forme en currentColor, traits en blanc écrits en dur (fonctionne aussi en <img>) ; à n'utiliser que si currentColor contraste à 3:1 au moins avec le blanc."
    }
  },
