{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "US-028 - direction « Marina » (palettes claires, 2026-11-02). Format DTCG (brouillon). Proposée après le retour du fondateur du 2026-11-02 ; en attente de son choix.",
  "meta": {
    "direction": "marina",
    "status": "PROPOSÉ : en attente du choix du fondateur ; nom Kmino tranché le 2026-11-02",
    "story": "US-028",
    "version": "0.1.0",
    "date": "2026-11-02",
    "wcag": "2.2 AA, ratios calculés (formule WCAG 2.x de luminance relative), voir contrastChecks",
    "concept": "Le port et la marine marchande : un bleu marine profond pour la confiance, posé sur un blanc cassé chaud couleur sable. Une élégance discrète, qui inspire le sérieux aux loueurs et aux voyageurs d'affaires.",
    "paletteLogic": "Complémentaire doux : un bleu marine froid (≈ 214°) équilibré par des neutres sable chauds (≈ 40°) ; le sable reste en aplats clairs, le marine porte toute l'action.",
    "notes": "Le nom et le logo sont des données de thème (US-034) : remplacer brand.name et brand.logo ne demande aucun développement. Le thème clair est la vitrine ; le thème sombre est obligatoire pour l'accessibilité."
  },
  "brand": {
    "name": {
      "$value": "Kmino",
      "$type": "string",
      "$description": "Valeur du paramètre {brand_name} (DEC-MARQUE, tranchée par le fondateur le 2026-11-02). Donnée de thème, révisable sans développement (US-034). Toujours en un seul mot, K majuscule, sans tiret ni point."
    },
    "parameter": {
      "$value": "{brand_name}",
      "$type": "string",
      "$description": "Le code n'écrit jamais le nom en dur : il lit ce paramètre."
    },
    "slug": {
      "$value": "kmino",
      "$type": "string",
      "$description": "Identifiant technique (domaines, comptes, paquets, clés) : minuscules, sans tiret."
    },
    "pronunciation": {
      "$value": "ka-MI-no",
      "$type": "string",
      "$description": "De camino et de km. En anglais : kah-MEE-no."
    },
    "wordmark": {
      "$value": "Kmino",
      "$type": "string",
      "$description": "Newsreader 600. Le K prend color.primary et « mino » color.text : la coupure K / mino n'est marquée que par la couleur, jamais par un tiret ou un point dans le texte."
    },
    "logo": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><rect x=\"3\" y=\"3\" width=\"42\" height=\"42\" rx=\"5\" fill=\"#1A3F70\"/><path d=\"M18 11v22M31 11L19 23M22.5 20L32 33\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"3.2\" stroke-linecap=\"square\"/><path d=\"M14 39h20\" stroke=\"#EBD9B0\" stroke-width=\"2.4\"/></svg>",
      "$type": "string",
      "$description": "Un carré marine aux angles à peine arrondis porte un K fin, souligné d'un trait sable (la ligne de flottaison). « Kmino » en Newsreader 600. Thème clair : K en on-primary (10.56:1 sur primary), repère #EBD9B0 (7.58:1)."
    },
    "logoDark": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><rect x=\"3\" y=\"3\" width=\"42\" height=\"42\" rx=\"5\" fill=\"#98BAE7\"/><path d=\"M18 11v22M31 11L19 23M22.5 20L32 33\" fill=\"none\" stroke=\"#0B1320\" stroke-width=\"3.2\" stroke-linecap=\"square\"/><path d=\"M14 39h20\" stroke=\"#0B1320\" stroke-width=\"2.4\"/></svg>",
      "$type": "string",
      "$description": "Thème sombre : pictogramme en primary sombre, K en on-primary (9.32:1), repère #0B1320 (9.32:1)."
    },
    "logoMono": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><rect x=\"3\" y=\"3\" width=\"42\" height=\"42\" rx=\"5\" fill=\"currentColor\"/><path d=\"M18 11v22M31 11L19 23M22.5 20L32 33\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"3.2\" stroke-linecap=\"square\"/><path d=\"M14 39h20\" stroke=\"#FFFFFF\" stroke-width=\"2.4\"/></svg>",
      "$type": "string",
      "$description": "Variante monochrome : forme en currentColor, traits en blanc écrits en dur (fonctionne aussi en <img>) ; à n'utiliser que si currentColor contraste à 3:1 au moins avec le blanc."
    }
  },
