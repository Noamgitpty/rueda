{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "US-028 - direction « Lagune » (palettes claires, 2026-11-02). Format DTCG (brouillon). Proposée après le retour du fondateur du 2026-11-02 ; en attente de son choix.",
  "meta": {
    "direction": "lagune",
    "status": "PROPOSÉ : en attente du choix du fondateur ; nom Kmino tranché le 2026-11-02",
    "story": "US-028",
    "version": "0.1.0",
    "date": "2026-11-02",
    "wcag": "2.2 AA, ratios calculés (formule WCAG 2.x de luminance relative), voir contrastChecks",
    "concept": "L'eau claire des lagons de Bocas del Toro et un corail tendre : une palette fraîche et souriante, très claire, qui parle aux voyageurs sans faire carte postale.",
    "paletteLogic": "Complémentaire : un bleu lagon (≈ 196°) et un corail doux (≈ 12°), opposés sur le cercle ; le corail reste un aplat clair de mise en avant, le bleu porte l'action.",
    "notes": "Le nom et le logo sont des données de thème (US-034) : remplacer brand.name et brand.logo ne demande aucun développement. Le thème clair est la vitrine ; le thème sombre est obligatoire pour l'accessibilité."
  },
  "brand": {
    "name": {
      "$value": "Kmino",
      "$type": "string",
      "$description": "Valeur du paramètre {brand_name} (DEC-MARQUE, tranchée par le fondateur le 2026-11-02). Donnée de thème, révisable sans développement (US-034). Toujours en un seul mot, K majuscule, sans tiret ni point."
    },
    "parameter": {
      "$value": "{brand_name}",
      "$type": "string",
      "$description": "Le code n'écrit jamais le nom en dur : il lit ce paramètre."
    },
    "slug": {
      "$value": "kmino",
      "$type": "string",
      "$description": "Identifiant technique (domaines, comptes, paquets, clés) : minuscules, sans tiret."
    },
    "pronunciation": {
      "$value": "ka-MI-no",
      "$type": "string",
      "$description": "De camino et de km. En anglais : kah-MEE-no."
    },
    "wordmark": {
      "$value": "Kmino",
      "$type": "string",
      "$description": "Outfit 600. Le K prend color.primary et « mino » color.text : la coupure K / mino n'est marquée que par la couleur, jamais par un tiret ou un point dans le texte."
    },
    "logo": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><rect x=\"2\" y=\"2\" width=\"44\" height=\"44\" rx=\"14\" fill=\"#0A6F94\"/><path d=\"M17 10v21M31 10L18.5 22M22.5 18.5l9 12.5\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"4.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M9 38.5q3.75-3 7.5 0t7.5 0 7.5 0 7.5 0\" fill=\"none\" stroke=\"#FFB8A6\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>",
      "$type": "string",
      "$description": "Un carré très arrondi bleu lagon porte un K blanc ; dessous, une vague corail. « Kmino » en Outfit 600, le K en bleu. Thème clair : K en on-primary (5.65:1 sur primary), repère #FFB8A6 (3.41:1)."
    },
    "logoDark": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><rect x=\"2\" y=\"2\" width=\"44\" height=\"44\" rx=\"14\" fill=\"#89D9F5\"/><path d=\"M17 10v21M31 10L18.5 22M22.5 18.5l9 12.5\" fill=\"none\" stroke=\"#06161C\" stroke-width=\"4.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M9 38.5q3.75-3 7.5 0t7.5 0 7.5 0 7.5 0\" fill=\"none\" stroke=\"#06161C\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>",
      "$type": "string",
      "$description": "Thème sombre : pictogramme en primary sombre, K en on-primary (11.68:1), repère #06161C (11.68:1)."
    },
    "logoMono": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><rect x=\"2\" y=\"2\" width=\"44\" height=\"44\" rx=\"14\" fill=\"currentColor\"/><path d=\"M17 10v21M31 10L18.5 22M22.5 18.5l9 12.5\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"4.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M9 38.5q3.75-3 7.5 0t7.5 0 7.5 0 7.5 0\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>",
      "$type": "string",
      "$description": "Variante monochrome : forme en currentColor, traits en blanc écrits en dur (fonctionne aussi en <img>) ; à n'utiliser que si currentColor contraste à 3:1 au moins avec le blanc."
    }
  },
