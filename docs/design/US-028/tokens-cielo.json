{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "US-028 - direction « Cielo » (palettes claires, 2026-11-02). Format DTCG (brouillon). Proposée après le retour du fondateur du 2026-11-02 ; en attente de son choix.",
  "meta": {
    "direction": "cielo",
    "status": "PROPOSÉ : direction recommandée par défaut, en attente du choix du fondateur ; nom Kmino tranché le 2026-11-02",
    "story": "US-028",
    "version": "0.1.0",
    "date": "2026-11-02",
    "wcag": "2.2 AA, ratios calculés (formule WCAG 2.x de luminance relative), voir contrastChecks",
    "concept": "Le ciel clair du Pacifique et des grandes plaines du Chaco : beaucoup de blanc, un bleu ciel franc qui ne sert qu'à agir, une encre bleu nuit pour lire. Le voyageur se sent attendu, l'agence garde un outil net.",
    "paletteLogic": "Monochrome nuancé : une seule teinte (bleu ciel, ≈ 203°) déclinée du blanc bleuté (50) à l'encre bleu nuit (900), sans couleur concurrente ; les états gardent leurs couleurs propres.",
    "notes": "Le nom et le logo sont des données de thème (US-034) : remplacer brand.name et brand.logo ne demande aucun développement. Le thème clair est la vitrine ; le thème sombre est obligatoire pour l'accessibilité."
  },
  "brand": {
    "name": {
      "$value": "Kmino",
      "$type": "string",
      "$description": "Valeur du paramètre {brand_name} (DEC-MARQUE, tranchée par le fondateur le 2026-11-02). Donnée de thème, révisable sans développement (US-034). Toujours en un seul mot, K majuscule, sans tiret ni point."
    },
    "parameter": {
      "$value": "{brand_name}",
      "$type": "string",
      "$description": "Le code n'écrit jamais le nom en dur : il lit ce paramètre."
    },
    "slug": {
      "$value": "kmino",
      "$type": "string",
      "$description": "Identifiant technique (domaines, comptes, paquets, clés) : minuscules, sans tiret."
    },
    "pronunciation": {
      "$value": "ka-MI-no",
      "$type": "string",
      "$description": "De camino et de km. En anglais : kah-MEE-no."
    },
    "wordmark": {
      "$value": "Kmino",
      "$type": "string",
      "$description": "Plus Jakarta Sans 800. Le K prend color.primary et « mino » color.text : la coupure K / mino n'est marquée que par la couleur, jamais par un tiret ou un point dans le texte."
    },
    "logo": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><circle cx=\"24\" cy=\"24\" r=\"22\" fill=\"#096CAA\"/><path d=\"M17.5 12v20M30.5 12L18.5 23.5M22.5 20l9 12\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"4.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 37.5c8-3.6 16-3.6 24 0\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>",
      "$type": "string",
      "$description": "Un disque bleu ciel porte un K blanc ; dessous, une courbe d'horizon (la route qui s'ouvre). Le mot « Kmino » en Plus Jakarta Sans 800, le K en bleu. Thème clair : K en on-primary (5.62:1 sur primary), repère #FFFFFF (5.62:1)."
    },
    "logoDark": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><circle cx=\"24\" cy=\"24\" r=\"22\" fill=\"#86CDF9\"/><path d=\"M17.5 12v20M30.5 12L18.5 23.5M22.5 20l9 12\" fill=\"none\" stroke=\"#06121C\" stroke-width=\"4.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 37.5c8-3.6 16-3.6 24 0\" fill=\"none\" stroke=\"#06121C\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>",
      "$type": "string",
      "$description": "Thème sombre : pictogramme en primary sombre, K en on-primary (10.90:1), repère #06121C (10.90:1)."
    },
    "logoMono": {
      "$value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\" role=\"img\" aria-label=\"Kmino\"><circle cx=\"24\" cy=\"24\" r=\"22\" fill=\"currentColor\"/><path d=\"M17.5 12v20M30.5 12L18.5 23.5M22.5 20l9 12\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"4.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M12 37.5c8-3.6 16-3.6 24 0\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg>",
      "$type": "string",
      "$description": "Variante monochrome : forme en currentColor, traits en blanc écrits en dur (fonctionne aussi en <img>) ; à n'utiliser que si currentColor contraste à 3:1 au moins avec le blanc."
    }
  },
